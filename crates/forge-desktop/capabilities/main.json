{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The only capability: the main window may listen for events, be dragged and maximised by its own top bar, and call Forge's own commands. No core:default (it grants event emit and more), no plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-trust-status",
    "allow-trust-workspace",
    "allow-choose-folder",
    "allow-list-projects",
    "allow-open-project",
    "allow-project-switch",
    "allow-project-add",
    "allow-project-trust",
    "allow-project-close",
    "allow-project-remove",
    "allow-project-relocate",
    "allow-subscribe",
    "allow-current-session",
    "allow-submit-prompt",
    "allow-submit-images",
    "allow-decide-approval",
    "allow-answer-question",
    "allow-answer-host-question",
    "allow-set-approve-all",
    "allow-clear-approvals",
    "allow-continue-turn",
    "allow-stop-session",
    "allow-close-session",
    "allow-fork-session",
    "allow-resume-session",
    "allow-list-resumable-sessions",
    "allow-rename-session",
    "allow-pin-session",
    "allow-cancel-queued",
    "allow-compact-context",
    "allow-set-thinking",
    "allow-cancel-background",
    "allow-resolve-child-approval",
    "allow-child-transcript",
    "allow-message-detail",
    "allow-create-session",
    "allow-select-session",
    "allow-archive-session",
    "allow-attach-worktree",
    "allow-remove-worktree",
    "allow-list-dir",
    "allow-find-files",
    "allow-read-file",
    "allow-read-image",
    "allow-git-status",
    "allow-github-issues",
    "allow-github-details",
    "allow-github-logs",
    "allow-github-create-pr",
    "allow-github-refresh-pr",
    "allow-github-apply-feedback",
    "allow-git-diff",
    "allow-git-operation",
    "allow-write-file",
    "allow-create-file",
    "allow-create-dir",
    "allow-rename-path",
    "allow-delete-path",
    "allow-search-files",
    "allow-git-stage",
    "allow-git-unstage",
    "allow-git-commit",
    "allow-git-branches",
    "allow-git-switch-branch",
    "allow-git-create-branch",
    "allow-git-merge-branch",
    "allow-git-rename-branch",
    "allow-set-unsaved",
    "allow-quit-app",
    "allow-git-restore",
    "allow-git-discard-hunk",
    "allow-git-last-turn-files",
    "allow-list-models",
    "allow-session-details",
    "allow-list-providers",
    "allow-list-themes",
    "allow-sandbox-grants",
    "allow-revoke-sandbox-grant",
    "allow-connect-provider",
    "allow-import-provider-login",
    "allow-disconnect-provider",
    "allow-add-model",
    "allow-save-custom-provider",
    "allow-update-custom-provider",
    "allow-remove-custom-provider",
    "allow-set-model",
    "allow-shell-open",
    "allow-shell-write",
    "allow-shell-resize",
    "allow-shell-close"
  ]
}
